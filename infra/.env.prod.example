# Copy to infra/.env.prod and fill in real values - infra/.env.prod itself
# is gitignored (matches the repo-wide `.env.*` pattern already used by
# services/control-plane-api/.env.example), never commit it.
#
# Used with: docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod ...

POSTGRES_USER=pterocontrol
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=pterocontrol

RABBITMQ_USER=pterocontrol
# Generate: openssl rand -base64 24
RABBITMQ_PASSWORD=

# 32-byte AES-256 key, base64. Generate your own, do not reuse the one in
# services/control-plane-api/.env.example or any local .env:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# A DIFFERENT key than SECRETS_MASTER_KEY - never reuse the same value for
# two different cryptographic purposes. Generate the same way.
JWT_SECRET=

# Gates POST /tenants (bootstrap). Generate the same way as the keys
# above. After bootstrapping your first tenant, consider rotating this
# (redeploy with a new value) since it has no other use afterwards - see
# TenantsService's own doc comment.
BOOTSTRAP_TOKEN=

# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> create
# a tunnel -> choose the "Docker" connector -> it gives you a token in
# this exact form. See infra/DEPLOYMENT.md for the full walkthrough.
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana's initial admin password (username is always "admin" on first
# boot). Generate: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=
