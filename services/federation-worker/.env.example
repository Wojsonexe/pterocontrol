# Musi wskazywać na tę samą bazę co control-plane-api (jedno źródło prawdy,
# jeden schemat Prisma - services/control-plane-api/prisma/schema.prisma).
DATABASE_URL="postgresql://pterocontrol:pterocontrol_dev_password@localhost:5432/pterocontrol?schema=public"

# Musi być IDENTYCZNY jak SECRETS_MASTER_KEY w control-plane-api/.env - ten
# sam klucz odszyfrowuje te same InstanceCredential.ciphertext w obu procesach.
SECRETS_MASTER_KEY="taki-sam-klucz-jak-w-control-plane-api"

# Broker kolejek - ten sam RabbitMQ co control-plane-api (publisher) używa.
RABBITMQ_URL="amqp://pterocontrol:pterocontrol_dev_password@localhost:5672"
