# Lokalne dane logowania z infra/docker-compose.yml — nie jest to prawdziwy
# sekret produkcyjny, tylko wartość dev-owa spójna z tamtym plikiem.
DATABASE_URL="postgresql://pterocontrol:pterocontrol_dev_password@localhost:5432/pterocontrol?schema=public"

# 32-bajtowy klucz AES-256 w base64. Wygeneruj własny, NIE używaj tego z .env:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY="wygeneruj-wlasny-klucz-32-bajty-base64"

# Sekret podpisujący JWT - INNY klucz niż SECRETS_MASTER_KEY (nigdy nie
# używaj tej samej wartości do dwóch różnych celów kryptograficznych).
# Wygeneruj własny: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="wygeneruj-wlasny-inny-klucz-niz-secrets-master-key"