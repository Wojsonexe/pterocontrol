{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/e2e/env-setup.ts"],
  "globalSetup": "<rootDir>/test/global-setup.js",
  "globalTeardown": "<rootDir>/test/global-teardown.js",
  "testTimeout": 30000
}
