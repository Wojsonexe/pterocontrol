generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  instances   PterodactylInstance[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique // owner | admin | operator | viewer | db_admin | db_read_only

  memberships Membership[]
}

model Membership {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  roleId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

enum InstanceStatus {
  PENDING_SYNC
  ONLINE
  DEGRADED
  UNREACHABLE
}

// global_id (this model's own `id`) is generated by Control Plane, never
// derived from anything Pterodactyl-side - see docs/architecture. Uniqueness
// of an instance within a tenant is enforced on (tenantId, baseUrl), not on
// any Pterodactyl-supplied identifier.
model PterodactylInstance {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  baseUrl      String
  status       InstanceStatus @default(PENDING_SYNC)
  panelVersion String?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime       @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials InstanceCredential[]
  servers     Server[]

  @@unique([tenantId, baseUrl])
  @@index([tenantId])
}

enum CredentialKind {
  APPLICATION_API_KEY
  CLIENT_API_KEY
}

model InstanceCredential {
  id         String         @id @default(uuid())
  instanceId String
  kind       CredentialKind
  ciphertext Bytes
  keyVersion Int            @default(1)
  createdAt  DateTime       @default(now())

  instance PterodactylInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, kind])
}

// Global server model (FAZA 4). global_id (own `id`) generated by Control
// Plane; local<->global mapping is (instanceId, pterodactylUuid), never the
// Pterodactyl-side numeric id alone (not unique across independent
// installs). tenantId is denormalized from the owning instance so
// tenant-scoped list/search/filter queries never need a join - it is only
// ever set from instance.tenantId server-side, never accepted from a client.
model Server {
  id              String   @id @default(uuid())
  tenantId        String
  instanceId      String
  pterodactylId   Int
  pterodactylUuid String
  identifier      String
  name            String
  nodeId          Int
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  instance  PterodactylInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  snapshots ResourceSnapshot[]

  @@unique([instanceId, pterodactylUuid])
  @@index([tenantId])
  @@index([instanceId])
}

// One row per observed reading (live GET /resources or, later, the
// periodic federation-worker collector) - never edited, only inserted.
// Deliberately no retention/rollup job yet (see IMPLEMENTATION_STATUS.md);
// this is raw storage, not a pre-aggregated time series.
model ResourceSnapshot {
  id                 String   @id @default(uuid())
  tenantId           String
  serverId           String
  observedAt         DateTime @default(now())
  cpuAbsolutePercent Float?
  memoryBytes        BigInt?
  diskBytes          BigInt?
  networkRxBytes     BigInt?
  networkTxBytes     BigInt?
  uptimeMs           BigInt?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
  @@index([tenantId, observedAt])
}

// Append-only. Every privileged action (power actions first; more follow
// as they're built) writes exactly one row here, success or failure -
// never edited or deleted through the API.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  result     String // success | denied | error
  metadata   Json?
  at         DateTime @default(now())

  @@index([tenantId, at])
}

// Idempotency ledger for federation-worker's RabbitMQ consumer. At-least-once
// delivery means the same jobId can be redelivered (worker crash after ack
// was sent but before it reached the broker, requeue after a nack, etc.) -
// before doing any side effect the worker checks whether jobId is already
// here; if so it just acks and skips. jobId unique constraint doubles as the
// race guard for two redeliveries processed concurrently by different
// worker instances (P2002 on insert -> already handled, not an error).
model ProcessedJob {
  id          String   @id @default(uuid())
  jobId       String   @unique
  jobType     String
  tenantId    String
  processedAt DateTime @default(now())

  @@index([tenantId, processedAt])
}

// "What happened" (system-observed, e.g. detected during a sync) - distinct
// from AuditLog ("who did what", operator-initiated actions). dedupKey has a
// unique constraint: EventsService.record() treats a P2002 violation on it
// as successful idempotent no-op, not an error - the same real transition
// observed twice (e.g. an overlapping sync retry) must not create two rows.
model Event {
  id         String   @id @default(uuid())
  tenantId   String
  instanceId String?
  serverId   String?
  type       String // instance_status_changed | server_created
  payload    Json
  occurredAt DateTime @default(now())
  dedupKey   String   @unique

  @@index([tenantId, occurredAt])
}